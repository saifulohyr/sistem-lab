# ─── LABMUMA — Production Environment Template ───────────────────
# Salin file ini menjadi .env.production lalu isi dengan nilai asli
# cp .env.production.example .env.production

# ─── Database (Supabase PostgreSQL) ──────────────────────────────
# Ambil dari Supabase Dashboard → Project → Settings → Database → Connection String
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Auth ─────────────────────────────────────────────────────────
# AUTH_SECRET: generate dengan: openssl rand -base64 32
AUTH_SECRET="GANTI_DENGAN_RANDOM_STRING_32_KARAKTER_MINIMAL"
NEXTAUTH_URL="https://app.labmuma.xyz"

# ─── Supabase Storage (Public Keys) ──────────────────────────────
# Ambil dari Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
